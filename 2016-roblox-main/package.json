{
  "name": "Roblox 2016 Frontend - ECS",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prod": "next build && next start",
    "test": "./node_modules/.bin/jest",
    "lint": "next lint"
  },
  "jest": {
    "transform": {
      "\\.js$": [
        "babel-jest",
        {
          "configFile": "./babel.config-test.js"
        }
      ]
    },
    "setupFilesAfterEnv": [
      "./setupTests.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!parse-domain)/"
    ]
  },
  "dependencies": {
    "@microsoft/signalr": "6.0.25",
    "@slack/webhook": "7.2.0",
    "axios": "1.21.0",
    "bootstrap": "5.3.8",
    "dayjs": "1.11.23",
    "jsonwebtoken": "8.5.1",
    "jss": "10.10.0",
    "lodash": "4.18.1",
    "next": "12.3.7",
    "nextjs-progressbar": "0.0.14",
    "parse-domain": "7.0.1",
    "qrcode.react": "4.2.0",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-jss": "10.10.0",
    "react-responsive": "10.0.1",
    "unstated-next": "1.1.0"
  }
}